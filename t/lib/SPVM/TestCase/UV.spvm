class TestCase::UV {
  use UV;
  use UV::Loop;
  use Sys;
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::IO;
  use Sys::Socket::Util;
  use Sys::Ioctl::Constant as IOCTL_C;
  use Sys::IO::Constant as IO_C;
  use UV::Constant as UV_C;
  
  static method test : int () {
    
    return 1;
  }
  
  static method poll : int () {
    
    my $loop = UV::Loop->new;
    
    my $client_fd = -1;
    my $accepted_fd = -1;
    &inet_socketpair(\$client_fd, \$accepted_fd, SOCKET_C->AF_INET, SOCKET_C->SOCK_STREAM, 0);
    
    Fn->defer([$client_fd : int, $accepted_fd : int] method : void () {
      Sys::IO->close($client_fd);
      Sys::IO->close($accepted_fd);
    });
    
    &set_blocking($client_fd, 0);
    &set_blocking($accepted_fd, 0);
    
    my $poll = UV::Handle::Poll->new;
    $loop->poll_init($poll, $client_fd);
    
    my $read_data = new_string_len 5;
    my $read_length_ref = [-1];
    my $status_ref = [-1];
    
    $poll->start([$client_fd : int, $read_data : mutable string, $read_length_ref : int[], $status_ref : int[]] method : void ($poll_handle : UV::Handle::Poll, $status : int, $events : int) {
      $status_ref->[0] = $status;
      $read_length_ref->[0] = Sys->sysread($client_fd, $read_data, 5);
      $poll_handle->close_safe;
    }, UV_C->UV_READABLE | UV_C->UV_WRITABLE);
    
    Sys->syswrite($accepted_fd, "hello", 5);
    
    $loop->run(UV_C->UV_RUN_DEFAULT);
    
    unless ($status_ref->[0] == 0) {
      return 0;
    }
    
    unless ($read_length_ref->[0] == 5 && $read_data eq "hello") {
      return 0;
    }
    
    return 1;
  }
  
  static method timer : int () {
    
    my $loop = UV::Loop->new;
    
    my $timer = UV::Handle::Timer->new;
    $loop->timer_init($timer);
    
    my $called_count_ref = [0];
    
    $timer->start([$called_count_ref : int[]] method : void ($timer_handle : UV::Handle::Timer) {
      $called_count_ref->[0]++;
      $timer_handle->close_safe;
    }, 10, 0);
    
    $loop->run(UV_C->UV_RUN_DEFAULT);
    
    unless ($called_count_ref->[0] == 1) {
      return 0;
    }
    
    return 1;
  }
  
  static method idle : int () {
    
    my $loop = UV::Loop->new;
    
    my $idle = UV::Handle::Idle->new;
    $loop->idle_init($idle);
    
    my $called_count_ref = [0];
    
    $idle->start([$called_count_ref : int[]] method : void ($idle_handle : UV::Handle::Idle) {
      $called_count_ref->[0]++;
      $idle_handle->close_safe;
    });
    
    $loop->run(UV_C->UV_RUN_DEFAULT);
    
    unless ($called_count_ref->[0] == 1) {
      return 0;
    }
    
    return 1;
  }
  
  static method async : int () {
    
    my $loop = UV::Loop->new;
    
    my $async = UV::Handle::Async->new;
    
    my $called_count_ref = [0];
    
    $loop->async_init($async, [$called_count_ref : int[]] method : void ($async_handle : UV::Handle::Async) {
      $called_count_ref->[0]++;
      $async_handle->close_safe;
    });
    
    Fn->defer([$async : UV::Handle::Async] method : void () {
      $async->close_safe;
    });
    
    $async->send;
    
    $loop->run(UV_C->UV_RUN_DEFAULT);
    
    unless ($called_count_ref->[0] == 1) {
      return 0;
    }
    
    return 1;
  }
  
  static method set_blocking : void ($fd : int, $blocking : int) {
    
    if (Sys::OS->is_windows) {
      my $flags = [(int)!$blocking];
      Sys->ioctl($fd, IOCTL_C->FIONBIO, $flags);
    }
    else {
      my $newmode = Sys->fcntl($fd, IO_C->F_GETFL);
      
      if ($blocking == 0) {
        $newmode &= ~IO_C->O_NDELAY;
        $newmode |= IO_C->O_NONBLOCK;
      }
      else {
        $newmode &= ~(IO_C->O_NDELAY|IO_C->O_NONBLOCK);
      }
      
      Sys->fcntl($fd, IO_C->F_SETFL, $newmode);
    }
  }
  
  static method inet_socketpair : void ($socket_fd1_ref : int*, $socket_fd2_ref : int*, $domain : int, $type : int, $protocol : int) {
    
    my $client_fd = -1;
    Sys->socket(\$client_fd, $domain, $type, $protocol);
    
    my $server_fd = -1;
    Sys->socket(\$server_fd, $domain, $type, $protocol);
    
    my $address = Sys::Socket::Util->inet_aton("127.0.0.1");
    my $tmp_port = 0;
    my $tmp_socket_address = Sys::Socket::Util->sockaddr_in($tmp_port, $address);
    Sys->bind($server_fd, $tmp_socket_address);
    Sys->listen($server_fd, SOCKET_C->SOMAXCONN);
    
    my $socket_address = (Sys::Socket::Sockaddr::In)Sys->getsockname($server_fd);
    
    Sys->connect($client_fd, $socket_address);
    
    my $accepted_fd = -1;
    Sys->accept(\$accepted_fd, $server_fd);
    
    Sys::IO->close($server_fd);
    
    $$socket_fd1_ref = $client_fd;
    $$socket_fd2_ref = $accepted_fd;
  }
  

}
